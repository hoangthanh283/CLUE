        <mxCell id="oshift_desc" value="A token labelled &lt;b&gt;O&lt;/b&gt; (background) in S1&lt;br&gt;becomes a named class in S3 (e.g. &lt;i&gt;total.cashprice&lt;/i&gt;)." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="200" y="526" width="250" height="36" as="geometry"/></mxCell>

        <!-- Arrow from S1 O-tag down to O-shift box (explicit points, avoids crossing S2) -->
        <mxCell id="oarr1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=6;strokeColor=#B3402F;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_otag" target="oshift_title"><mxGeometry relative="1" as="geometry"><mxPoint x="96" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <!-- Arrow from S3 named entity down to O-shift box -->
        <mxCell id="oarr2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=6;strokeColor=#B3402F;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_otag" target="oshift_title"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- LEGEND -->
