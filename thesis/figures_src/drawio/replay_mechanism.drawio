<mxfile host="Electron" modified="2026-06-13T10:35:00.000Z" agent="claude-code" version="22.1.2" etag="replmech01" type="device">
  <diagram name="replay_mechanism" id="replmech">
    <mxGraphModel dx="954" dy="669" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="370" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Why replay works: linking the diagnosis to the benchmark result" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontStyle=1;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="10" y="12" width="880" height="26" as="geometry" />
        </mxCell>
        <mxCell id="boxA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBE8F7;strokeColor=#2C6FB3;" parent="1" vertex="1"><mxGeometry x="30" y="70" width="252" height="140" as="geometry" /></mxCell>
        <mxCell id="boxA_t" value="Diagnosis (&#167;6.1)" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#1A4E80;" parent="1" vertex="1"><mxGeometry x="44" y="78" width="220" height="20" as="geometry" /></mxCell>
        <mxCell id="boxA_b" value="Forgetting concentrates at the classifier head and late layers. The head dominates Fisher importance (2.2&#215;10&lt;sup&gt;-1&lt;/sup&gt;) and drifts most (CKA 0.215); the input encoders stay stable." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="44" y="100" width="224" height="104" as="geometry" /></mxCell>
        <mxCell id="boxB" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEFE1;strokeColor=#3A9D4E;" parent="1" vertex="1"><mxGeometry x="324" y="70" width="252" height="140" as="geometry" /></mxCell>
        <mxCell id="boxB_t" value="Mechanism: experience replay" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#1E5A2E;" parent="1" vertex="1"><mxGeometry x="338" y="78" width="224" height="20" as="geometry" /></mxCell>
        <mxCell id="boxB_b" value="A small buffer of past-task examples is replayed at every step. Old-class targets keep producing gradient at the output head, so the head is not overwritten as new tasks arrive." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="338" y="100" width="224" height="104" as="geometry" /></mxCell>
        <mxCell id="boxC" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C9E7D0;strokeColor=#3A9D4E;" parent="1" vertex="1"><mxGeometry x="618" y="70" width="252" height="140" as="geometry" /></mxCell>
        <mxCell id="boxC_t" value="Outcome (&#167;6.2)" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#1E5A2E;" parent="1" vertex="1"><mxGeometry x="632" y="78" width="220" height="20" as="geometry" /></mxCell>
        <mxCell id="boxC_b" value="The head stays aligned with earlier tasks. On DIL: AA 88.2 and BWT &#8776; 0 - matching the Joint oracle (84.8); forgetting is essentially eliminated." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="632" y="100" width="224" height="104" as="geometry" /></mxCell>
        <mxCell id="arrAB" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6E6E6E;strokeWidth=2;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="140" as="sourcePoint" /><mxPoint x="322" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="arrBC" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6E6E6E;strokeWidth=2;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="578" y="140" as="sourcePoint" /><mxPoint x="616" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="hyp_bg" value="" style="rounded=1;html=1;fillColor=#F2EDF8;strokeColor=#8055B5;" parent="1" vertex="1"><mxGeometry x="30" y="226" width="840" height="56" as="geometry" /></mxCell>
        <mxCell id="hyp_t" value="Hypothesis (open):" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#5A3A86;" parent="1" vertex="1"><mxGeometry x="44" y="232" width="140" height="18" as="geometry" /></mxCell>
        <mxCell id="hyp_b" value="because the forgetting locus is output-facing, a mechanism that targets the head / late layers directly - the proposed DocCL - could match replay without storing past data. To be tested once the method is finalised." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="186" y="231" width="676" height="46" as="geometry" /></mxCell>
        <mxCell id="contrast" value="Why not the others? EWC constrains all weights broadly &#8594; partial help, mainly under domain shift. LwF distils old-class logits that decay as the head grows &#8594; no measurable benefit in dense token classification." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="30" y="294" width="840" height="34" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
