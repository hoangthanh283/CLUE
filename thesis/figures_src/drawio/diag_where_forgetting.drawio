        <mxCell id="title" value="Where forgetting lives in LayoutLMv3 - synthesis of the per-component diagnosis" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontStyle=1;fontColor=#222222;" parent="1" vertex="1">
