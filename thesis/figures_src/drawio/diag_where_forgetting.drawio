        <mxCell id="co_bg" value="" style="rounded=1;html=1;fillColor=#FBFBFB;strokeColor=#8895A6;" parent="1" vertex="1"><mxGeometry x="600" y="74" width="308" height="300" as="geometry" /></mxCell>
        <mxCell id="co_t1" value="Finding" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="616" y="82" width="120" height="20" as="geometry" /></mxCell>
        <mxCell id="co_b1" value="Forgetting concentrates in the classifier head and late encoder layers; the input encoders are stable. It is &lt;b&gt;not&lt;/b&gt; a fusion-specific effect - the full multimodal model is statistically indistinguishable from its modality ablations (GATE-A). Text is the load-bearing stream." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="616" y="104" width="278" height="104" as="geometry" /></mxCell>
        <mxCell id="co_div" value="" style="endArrow=none;html=1;strokeColor=#CCCCCC;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="616" y="214" as="sourcePoint" /><mxPoint x="892" y="214" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="co_t2" value="Hypothesis (open)" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#2C6FB3;" parent="1" vertex="1"><mxGeometry x="616" y="222" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="co_b2" value="Because the forgetting locus is output-facing, remedies that protect or re-expose the head - e.g. experience replay - should be most effective. &#167;6.2 confirms replay essentially eliminates forgetting on DIL. A mechanism that targets the head / late layers specifically (DocCL) is the open extension." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#333333;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="616" y="244" width="278" height="124" as="geometry" /></mxCell>
        <mxCell id="prelim" value="Preliminary - pilot diagnosis (C4, naive sequential, 3 seeds)." style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=10;fontStyle=2;fontColor=#888888;" parent="1" vertex="1"><mxGeometry x="110" y="378" width="480" height="16" as="geometry" /></mxCell>
