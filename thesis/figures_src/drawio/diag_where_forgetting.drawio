        <mxCell id="an_head" value="CKA 0.215 &#183; Fisher 2.2&#215;10&lt;sup&gt;-1&lt;/sup&gt; (dominant)" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#B3402F;" parent="1" vertex="1"><mxGeometry x="360" y="92" width="230" height="20" as="geometry" /></mxCell>
        <mxCell id="an_l11" value="CKA 0.245 - high drift" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#A85A1E;" parent="1" vertex="1"><mxGeometry x="360" y="152" width="230" height="20" as="geometry" /></mxCell>
        <mxCell id="an_mid" value="CKA 0.344 (layer 5) - drifting" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#7A6212;" parent="1" vertex="1"><mxGeometry x="360" y="212" width="230" height="20" as="geometry" /></mxCell>
        <mxCell id="an_early" value="CKA 0.777 (layer 0) - mostly stable" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#3F5A1E;" parent="1" vertex="1"><mxGeometry x="360" y="272" width="230" height="20" as="geometry" /></mxCell>
