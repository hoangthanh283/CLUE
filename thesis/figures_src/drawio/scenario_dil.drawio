        <!-- ===== BOTTOM NOTES ===== -->
        <mxCell id="seqnote" value="Training sequence FUNSD &#8594; SROIE &#8594; CORD orders the domains by increasing distance from the canonical form schema. The label space L is &lt;b&gt;fixed&lt;/b&gt;; only the input distribution P&lt;sub&gt;t&lt;/sub&gt;(X) shifts at each session boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFB;strokeColor=#8895A6;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="328" width="980" height="40" as="geometry"/></mxCell>

        <mxCell id="caveat" value="Caveat: KEY is sparse outside FUNSD &#8212; COMPANY is the only KEY-like field in SROIE, and CORD has no KEY at all (recorded as a known limitation)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9DE;strokeColor=#B3402F;fontFamily=Times New Roman;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="980" height="32" as="geometry"/></mxCell>

