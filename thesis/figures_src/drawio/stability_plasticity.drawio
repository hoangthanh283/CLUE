        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="lg_bg" value="" style="rounded=1;html=1;fillColor=#FBFBFB;strokeColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="100" y="584" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="lg_dot1" value="" style="ellipse;html=1;fillColor=#2C6FB3;strokeColor=#2C6FB3;" vertex="1" parent="1"><mxGeometry x="116" y="594" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="lg_t1" value="Text stream" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="132" y="592" width="100" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_dot2" value="" style="ellipse;html=1;fillColor=#3A9D4E;strokeColor=#3A9D4E;" vertex="1" parent="1"><mxGeometry x="256" y="594" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="lg_t2" value="Layout stream" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="272" y="592" width="110" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_dot3" value="" style="ellipse;html=1;fillColor=#8055B5;strokeColor=#8055B5;" vertex="1" parent="1"><mxGeometry x="408" y="594" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="lg_t3" value="Fusion stream" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="424" y="592" width="110" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_note" value="Schematic only — no numeric scale" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontStyle=2;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="556" y="592" width="232" height="16" as="geometry"/></mxCell>

