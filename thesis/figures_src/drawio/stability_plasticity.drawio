        </mxCell>
        <mxCell id="seg3" value="" style="curved=1;endArrow=none;html=1;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="372" y="248" as="sourcePoint"/>
            <mxPoint x="498" y="368" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="432" y="300"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="seg4" value="" style="curved=1;endArrow=none;html=1;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="368" as="sourcePoint"/>
            <mxPoint x="628" y="492" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="564" y="428"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Frontier label -->
        <mxCell id="frontier_lbl" value="Stability–Plasticity frontier" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontStyle=2;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="308" y="154" width="210" height="18" as="geometry"/></mxCell>
        <!-- small arrow from frontier label to curve -->
        <mxCell id="e_fl" value="" style="endArrow=open;endSize=6;html=1;strokeColor=#888888;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="308" y="163" as="sourcePoint"/>
            <mxPoint x="264" y="168" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== ENDPOINT DOTS ===== -->
        <!-- Frozen backbone: upper-left near (162,120) -->
        <mxCell id="dot_frozen" value="" style="ellipse;html=1;fillColor=#2C6FB3;strokeColor=#2C6FB3;" vertex="1" parent="1"><mxGeometry x="148" y="106" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="lbl_frozen" value="Frozen backbone&lt;br&gt;(high stability, low plasticity)" style="text;html=1;align=left;fontFamily=Times New Roman;fontSize=11;fontColor=#2C6FB3;" vertex="1" parent="1"><mxGeometry x="176" y="86" width="226" height="34" as="geometry"/></mxCell>

        <!-- Naive fine-tuning: lower-right near (628,492) -->
        <mxCell id="dot_naive" value="" style="ellipse;html=1;fillColor=#B3402F;strokeColor=#B3402F;" vertex="1" parent="1"><mxGeometry x="614" y="478" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="lbl_naive" value="Naive fine-tuning&lt;br&gt;(high plasticity, low stability)" style="text;html=1;align=right;fontFamily=Times New Roman;fontSize=11;fontColor=#B3402F;" vertex="1" parent="1"><mxGeometry x="400" y="490" width="210" height="34" as="geometry"/></mxCell>

        <!-- ===== CL METHODS REGION ===== -->
        <!-- Shaded ellipse region in the middle of the frontier -->
        <mxCell id="cl_region" value="" style="ellipse;html=1;fillColor=#F0ECF7;strokeColor=#8055B5;strokeWidth=1;dashed=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="300" y="196" width="220" height="140" as="geometry"/></mxCell>
        <mxCell id="lbl_cl" value="CL methods&lt;br&gt;operate here" style="text;html=1;align=center;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#8055B5;" vertex="1" parent="1"><mxGeometry x="318" y="268" width="184" height="40" as="geometry"/></mxCell>

        <!-- ===== PER-COMPONENT MARKERS (near the frontier, in text/layout/fusion colours) ===== -->
        <!-- Text-stream marker: near (310,215) on the curve -->
        <mxCell id="dot_text" value="" style="ellipse;html=1;fillColor=#2C6FB3;strokeColor=#2C6FB3;" vertex="1" parent="1"><mxGeometry x="296" y="208" width="12" height="12" as="geometry"/></mxCell>
        <!-- Layout-stream marker: near (460,340) -->
