<mxfile host="app.diagrams.net" type="device">
  <diagram name="stability_plasticity" id="stabplast">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== TITLE ===== -->
        <mxCell id="title" value="Stability–Plasticity Trade-off (Illustrative)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="900" height="26" as="geometry"/></mxCell>

        <!-- ===== AXES ===== -->
        <!-- Y-axis arrow (Stability) -->
        <mxCell id="yaxis" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="530" as="sourcePoint"/>
            <mxPoint x="130" y="80" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- X-axis arrow (Plasticity) -->
        <mxCell id="xaxis" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="530" as="sourcePoint"/>
            <mxPoint x="760" y="530" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Axis labels -->
        <mxCell id="ylabel" value="Stability&lt;br&gt;(retention of old tasks) &amp;#8594;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontStyle=1;rotation=-90;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="xlabel" value="Plasticity (capacity to learn new tasks) &amp;#8594;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="544" width="440" height="28" as="geometry"/></mxCell>

        <!-- ===== FRONTIER CURVE (convex, 5 segments approximating smooth arc) ===== -->
        <!-- Points: A(160,120) upper-left, B(240,160), C(360,240), D(490,360), E(620,490) lower-right -->
        <mxCell id="seg1" value="" style="curved=1;endArrow=none;html=1;strokeColor=#444444;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="162" y="120" as="sourcePoint"/>
            <mxPoint x="252" y="160" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="200" y="128"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="seg2" value="" style="curved=1;endArrow=none;html=1;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="252" y="160" as="sourcePoint"/>
            <mxPoint x="372" y="248" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="310" y="196"/>
