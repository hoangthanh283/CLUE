        <!-- Fusion-stream marker: moved left/up out of label area -->
        <mxCell id="dot_fusion" value="" style="ellipse;html=1;fillColor=#8055B5;strokeColor=#8055B5;" vertex="1" parent="1"><mxGeometry x="354" y="248" width="12" height="12" as="geometry"/></mxCell>

        <!-- Note callout box -->
        <mxCell id="note_box" value="Per-component operating&lt;br&gt;points may differ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFBFB;strokeColor=#8895A6;fontFamily=Times New Roman;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="574" y="186" width="188" height="44" as="geometry"/></mxCell>
        <!-- Arrow from note to markers area -->
        <mxCell id="e_note" value="" style="endArrow=open;endSize=6;html=1;strokeColor=#8895A6;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
